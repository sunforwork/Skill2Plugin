{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skill2plugin",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./.generated/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/_content/*"]
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
